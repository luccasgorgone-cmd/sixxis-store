# Database
DATABASE_URL="mysql://user:pass@host:port/db"

# NextAuth
NEXTAUTH_SECRET="replace-me-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Admin security (Sprint 1)
# Gere o hash com: node -e "require('bcryptjs').hash('SUA_SENHA_FORTE', 12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-real-hash"
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-48-bytes-base64"
# Sufixo da URL admin (rota física em src/app/adm-a7f9c2b4/)
ADMIN_PATH_TOKEN="adm-a7f9c2b4"
# Path PÚBLICO do admin, configurável (rotação). O proxy reescreve este path para
# a rota física interna /adm-a7f9c2b4 e responde 404 no path interno quando este
# difere. Precisa ser NEXT_PUBLIC_ (build-time) porque os links são client-side.
# Vazio/ausente → usa o default 'adm-a7f9c2b4' e nada muda. Trocar exige redeploy.
NEXT_PUBLIC_ADMIN_PATH="adm-a7f9c2b4"

# Mercado Pago
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_ACCESS_TOKEN=""

# Checkout com 2 métodos de pagamento (2 cartões, ou Pix+cartão) — orquestração
# via Orders API do MP já existe (checkout-multi-metodo.ts), mas 2 assunções
# nunca foram confirmadas contra o MP real (ver TODO-SANDBOX no código: se
# deleteTransaction desfaz autorização de cartão, e se a Order aceita combo
# heterogêneo de métodos). "false"/ausente → oculto do cliente (default seguro).
# Só ligar depois de validar os 2 fluxos em sandbox.
CHECKOUT_MULTI_METODO_HABILITADO="false"

# Focus NFe — emissão de NF-e das vendas do site (acionamento manual no admin).
# FOCUS_NFE_AMBIENTE é a chave ÚNICA: decide ao mesmo tempo a baseURL
# (homologacao.focusnfe.com.br | api.focusnfe.com.br) e QUAL token é usado.
# Qualquer valor diferente de "producao" cai em homologação (default seguro).
# Em homologação o nome do destinatário é FORÇADO para o texto de teste exigido
# pela SEFAZ — nota sem valor fiscal, impossível confundir com real.
# Os tokens são SERVER-ONLY: nunca prefixe com NEXT_PUBLIC_.
FOCUS_NFE_AMBIENTE="homologacao"
FOCUS_NFE_TOKEN_HOMOLOGACAO=""
FOCUS_NFE_TOKEN_PRODUCAO=""

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Tag Manager — container que hospeda a tag GA4 (o site NÃO carrega
# gtag.js/GA4 direto, só o container inteiro via GtmScript.tsx). Vazio/ausente
# → GTM não carrega (guard no GtmScript). Container atual: GTM-KW48KLGT.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Analytics — Meta Pixel (Facebook/Instagram Ads)
# Vazio/ausente → Pixel não carrega (guard no MetaPixelScript). NÃO instalar o
# Pixel também via GTM (evento dobrado). Dispara nos mesmos pontos do GA4.
NEXT_PUBLIC_META_PIXEL_ID="500285526352954"

# Meta Conversions API (CAPI) — Purchase server-side via webhook do Mercado Pago.
# System User token (Eventos > Configurações > Gerar token de acesso). SERVER-ONLY,
# NUNCA exponha no client. Ausente → o CAPI Purchase é pulado (log, sem quebrar o
# pedido); o Pixel do browser continua. PIXEL_ID reusa NEXT_PUBLIC_META_PIXEL_ID.
META_CAPI_ACCESS_TOKEN=""

# GA4 Measurement Protocol — Purchase server-side via webhook do Mercado Pago
# (mesmo padrão do CAPI Meta acima). Vira a ÚNICA fonte do evento `purchase`
# pro GA4 — o dataLayer.push do browser foi removido (evita contar 2x). Sem
# essas 2 vars, o envio é pulado (log, sem quebrar o pedido). Gerar em GA4 >
# Admin > Fluxos de dados > Measurement Protocol API secrets. SERVER-ONLY.
GA4_MEASUREMENT_ID=""
GA4_MP_API_SECRET=""

# E-mail transacional (Resend)
# Sem RESEND_API_KEY o envio degrada graciosamente: loga e não quebra o fluxo.
# EMAIL_FROM precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=""
EMAIL_FROM="noreply@sixxis.com.br"
EMAIL_FROM_NAME="Sixxis"

# ERP
ERP_API_URL="http://localhost:3001"
ERP_API_SECRET=""

# Melhor Envio
MELHOR_ENVIO_TOKEN=""

# Transportadoras (módulo carriers) — cotação de frete em tempo real
# Braspress: liga com CARRIERS_BRASPRESS_ENABLED="true". Auth Basic é montada em
# runtime (base64 de USER:PASSWORD); nada é hardcoded.
CARRIERS_BRASPRESS_ENABLED="false"
BRASPRESS_CNPJ_REMETENTE=""
BRASPRESS_API_USER=""
BRASPRESS_API_PASSWORD=""
BRASPRESS_CEP_ORIGEM=""

# Melhor Envio (carriers): liga com CARRIERS_MELHORENVIO_ENABLED="true".
# Auth Bearer token; User-Agent é OBRIGATÓRIO (a API bloqueia sem ele).
# MELHORENVIO_CEP_ORIGEM é opcional — se vazio, usa BRASPRESS_CEP_ORIGEM (mesma origem).
CARRIERS_MELHORENVIO_ENABLED="false"
MELHORENVIO_TOKEN=""
MELHORENVIO_USER_AGENT=""
MELHORENVIO_CEP_ORIGEM=""

# Cloudflare R2
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Gateway (Sprint 2) — chaves de API dos sistemas externos
ERP_API_KEY="replace-me"
NFE_API_KEY="replace-me"
WEBHOOK_API_KEY="replace-me"

# Cloudflare Turnstile (anti-bot) — DEGRADAÇÃO GRACIOSA: sem estas vars o widget
# não renderiza e o servidor não verifica (login/cadastro seguem normais).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis (rate-limit) — DEGRADAÇÃO GRACIOSA: sem estas vars o rate-limit
# é desligado (nenhuma rota é bloqueada).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# API interna para o CRM (ponte CRM<->loja). Header x-internal-key.
# Gere uma chave forte: openssl rand -hex 32
STORE_INTERNAL_KEY=""

# URL pública do CRM (ponte loja->CRM). A Loja chama {CRM_API_URL}/api/interno/crm/*
# do SERVIDOR (route handler), autenticando com STORE_INTERNAL_KEY (a MESMA chave
# acima — não há chave nova). Sem esta var, o envio de dados ao CRM fica desligado
# (o modal mostra mensagem tratável; nada quebra). Ex.: https://crm.sixxis...app
CRM_API_URL=""
